# ---- Monday.com (required) ----
# Personal API token: monday.com -> avatar -> Developers -> My access tokens
# The agent only ever issues read queries. A read-only token is sufficient and recommended.
MONDAY_API_TOKEN=your_monday_api_token_here

# Numeric board IDs (from the board URL: /boards/<BOARD_ID>)
MONDAY_DEALS_BOARD_ID=1234567890
MONDAY_WORK_ORDERS_BOARD_ID=1234567891

# Optional: Monday API version pin
# MONDAY_API_VERSION=2024-10


# ---- LLM provider (required: pick ONE) ----
# Which vendor answers questions. If omitted, the first key present is used, in
# the order gemini -> groq -> anthropic. Only the SELECTED provider's key is
# required; the others may be absent entirely.
LLM_PROVIDER=gemini

# --- Option A: Google Gemini (primary; free tier via Google AI Studio) ---
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# Optional model override. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Groq (free tier, but only 8k tokens/minute) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# --- Option C: Anthropic (paid) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5


# ---- Optional ----
# Seconds to cache Monday board snapshots server-side (default 300)
# DATA_CACHE_TTL_SECONDS=300

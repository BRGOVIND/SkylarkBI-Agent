# ---- Monday.com (required) ----
# Personal API token: monday.com -> avatar -> Developers -> My access tokens
# The agent only ever issues read queries. A read-only token is sufficient and recommended.
MONDAY_API_TOKEN=your_monday_api_token_here

# Numeric board IDs (from the board URL: /boards/<BOARD_ID>)
MONDAY_DEALS_BOARD_ID=1234567890
MONDAY_WORK_ORDERS_BOARD_ID=1234567891

# Optional: Monday API version pin
# MONDAY_API_VERSION=2024-10

# ---- Anthropic (required) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Optional ----
# Seconds to cache Monday board snapshots server-side (default 300)
# DATA_CACHE_TTL_SECONDS=300

# ---- Monday.com (required) ----
# Personal API token: monday.com -> avatar -> Developers -> My access tokens
# The agent only ever issues read queries. A read-only token is sufficient and recommended.
MONDAY_API_TOKEN=your_monday_api_token_here

# Numeric board IDs (from the board URL: /boards/<BOARD_ID>)
MONDAY_DEALS_BOARD_ID=1234567890
MONDAY_WORK_ORDERS_BOARD_ID=1234567891

# Optional: Monday API version pin
# MONDAY_API_VERSION=2024-10


# ---- LLM provider (required: pick ONE) ----
# Which vendor answers questions. If omitted, "groq" is used when GROQ_API_KEY
# is set, otherwise "anthropic". Only the selected provider's key is required.
LLM_PROVIDER=groq

# --- Option A: Groq (has a free tier) ---
GROQ_API_KEY=gsk_...
# Optional model override. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# --- Option B: Anthropic (paid) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override. Default: claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5


# ---- Optional ----
# Seconds to cache Monday board snapshots server-side (default 300)
# DATA_CACHE_TTL_SECONDS=300
